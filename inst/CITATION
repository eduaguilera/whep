citHeader("To cite whep in publications use:")

# Prefer the release date of the installed version; fall back to the current
# year when building from a source checkout, where Date/Publication is unset.
whep_year <- if (is.null(meta$`Date/Publication`)) {
  format(Sys.Date(), "%Y")
} else {
  substr(meta$`Date/Publication`, 1, 4)
}

bibentry(
  key = "whep",
  bibtype = "Manual",
  title = "whep: Processing Agro-Environmental Data",
  author = c(
    person("Catalin", "Covaci"),
    person("Eduardo", "Aguilera"),
    person("Alice", "Beckmann"),
    person("Juan", "Infante"),
    person("Justin", "Morgan")
  ),
  year = whep_year,
  doi = "10.32614/CRAN.package.whep",
  url = "https://eduaguilera.github.io/whep/",
  note = paste(
    "R package version",
    meta$Version
  )
)

